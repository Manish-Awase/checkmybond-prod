# syntax=docker/dockerfile:1
# hitl-go/Dockerfile.server
# Multi-stage build — Go API server (port 8000)

FROM golang:1.26-alpine3.24 AS builder

WORKDIR /build

# No go.sum is committed to the repo, so resolve + download + verify
# dependencies in one step at build time.
COPY go.mod ./
COPY . .

# BuildKit cache mounts — the Go module cache (/go/pkg/mod) and build
# cache (/root/.cache/go-build) persist across separate `docker build`
# invocations on the same machine. This means hitl-server and
# hitl-gateway share downloaded dependencies instead of each
# re-downloading all 7 packages independently. Requires BuildKit
# (default in `docker compose build` on modern Docker — no extra flag).
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod tidy && go mod download

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -o /build/hitl-server ./cmd/server

# ── Final stage — minimal runtime image ───────────────────────────────────────
FROM alpine:3.20
RUN apk add --no-cache ca-certificates
WORKDIR /app

COPY --from=builder /build/hitl-server .

# Mount points — populated via docker-compose volumes
RUN mkdir -p /app/export /app/uploads

EXPOSE 8000
ENTRYPOINT ["./hitl-server"]
