# ops/backup/backup.env  (copy from backup.env.example, then: chmod 600 backup.env)
# Do NOT commit the real file - it holds your DB password and API keys.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/checkmybond
# If Postgres runs in Docker and pg_dump is not installed on the host, use this
# INSTEAD of DATABASE_URL (container name from `docker ps`):
# PG_DOCKER_CONTAINER=checkmybond-db
# PG_DOCKER_USER=postgres
# PG_DOCKER_DB=checkmybond

BACKUP_DIR=/var/backups/checkmybond

# ══ WHERE BACKUPS LIVE ══════════════════════════════════════════════════════
#   local = keep on the server; you copy old months to your laptop (pull_backups.sh)
#   s3    = also upload every backup to S3, verify it, then remove it from the server
# To start using S3 later: fill in the S3_* values below and change this to s3. Nothing else.
BACKUP_STORAGE=local

# ── Limits (whole numbers) ──────────────────────────────────────────────────
BACKUP_ALERT_MB=100        # early-warning email at/above this size
BACKUP_MAX_MB=500          # "limit reached" email + auto-delete. Set 800 or 1000 any time.
BACKUP_GRACE_MONTHS=3      # local mode: current month + previous 3 months are NEVER auto-deleted
ALERT_COOLDOWN_HOURS=23    # at most one email of each kind per this many hours

# ── S3 (only used when BACKUP_STORAGE=s3) ───────────────────────────────────
S3_BUCKET=
S3_PREFIX=checkmybond-backups   # folder inside the bucket
S3_REGION=ap-south-1
S3_KEEP_LOCAL_DAYS=7       # keep this many days on the server for fast restore; 0 = remove right after upload
# S3_STORAGE_CLASS=STANDARD_IA          # optional, cheaper for rarely-read backups
# S3_ENDPOINT_URL=                      # only for non-AWS S3 services (Wasabi, Cloudflare R2, MinIO...)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── healthchecks.io ─────────────────────────────────────────────────────────
HC_PING_URL=https://hc-ping.com/your-check-uuid-here

# ── Email alerts (same providers as the app) ────────────────────────────────
BACKUP_ALERT_EMAIL_TO=you@yourdomain.com      # comma-separated for several
EMAIL_PROVIDER=brevo                          # brevo | sendgrid | smtp | stdout (log only)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
