# .env.aws.example
# Copy to .env on the EC2 host, fill in the real values, then run:
#   docker compose -f docker-compose.aws.yml up --build -d
#
# Every variable below is read by docker-compose.aws.yml. Nothing here
# changes application code — Go still reads DATABASE_URL as postgres://
# and Python (SQLAlchemy) is assembled internally as postgresql://.

# ── RDS PostgreSQL 16 ──────────────────────────────────────────────────
# Used directly by the Go API server (hitl-server) via pgxpool.
# Format: postgres://<user>:<password>@<rds-endpoint>:5432/<dbname>
DATABASE_URL=postgres://hitl_user:CHANGE_ME@project11-db.xxxxxxxxxxxx.ap-south-1.rds.amazonaws.com:5432/hitl

# Same RDS instance, broken into parts for the Celery worker.
# celery-worker reassembles these into a postgresql+psycopg2:// URL
# because SQLAlchemy rejects the bare postgres:// scheme above.
DB_USER=hitl_user
DB_PASSWORD=CHANGE_ME
DB_HOST=project11-db.xxxxxxxxxxxx.ap-south-1.rds.amazonaws.com
DB_NAME=hitl

# ── ElastiCache Redis (cluster mode DISABLED) ──────────────────────────
# Non-cluster mode is required because the project switches between
# Redis logical databases (SELECT 0 / 1 / 2) for the token blacklist
# (DB0) and Celery broker (DB1) — cluster mode does not support
# multiple logical databases.
# Primary endpoint, no port and no db index — the app appends those itself.
REDIS_HOST=project11-redis.xxxxxx.ng.0001.aps1.cache.amazonaws.com

# ── JWT / Auth ──────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-real-256-bit-secret using "openssl rand -hex 32"
OWNER_USERNAME=owner
OWNER_PASSWORD=CHANGE_ME

# ── Gateway ───────────────────────────────────────────────────────────
CORS_ORIGINS=https://your-domain-or-ec2-public-dns
EXPOSE_DOCS=false

# ── Upload pipeline toggle ────────────────────────────────────────────────
# false (default) = OCR region-drawing on Step 1, no LLM/API-key dependency.
# true = schema-based extraction pipeline (services/extractor.py etc.) —
# requires GROQ_API below to actually work, not just this flag.
USE_LLM=false

# ── LLM providers (Celery worker) ───────────────────────────────────────
# GROQ_API is required if USE_LLM=true — services/extractor.py, evaluator.py,
# table_tagger.py, and reextractor.py all call Groq directly. Get a key at
# console.groq.com. If you're staying on USE_LLM=false, you can leave this blank.
GROQ_API=your-groq-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Payment (hitl-server: routers/payment.go, internal/payment) ─────────
# plan_transactions storage backend — postgres (default) or mysql
DB_DRIVER=postgres

# Which gateway processes charges: mock | stripe | razorpay
# Leave as "mock" until you're ready to take real money — it always
# succeeds instantly and needs no keys, so the app runs out of the box.
PAYMENT_GATEWAY=mock

# Stripe (used when PAYMENT_GATEWAY=stripe)
# Secret key stays server-side only. Publishable key is safe to expose to
# the frontend and is returned to it in the /api/payment/pay response.
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_xxx
# Signing secret for the webhook endpoint at /api/payment/webhook/stripe —
# generated in Stripe Dashboard > Developers > Webhooks when you add that
# URL. Different from STRIPE_SECRET_KEY above.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Razorpay (used when PAYMENT_GATEWAY=razorpay)
# key_secret stays server-side only, used to create orders and verify
# Checkout signatures. key_id is safe to expose to the frontend.
RAZORPAY_KEY_ID=rzp_live_or_test_xxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Separate secret for the webhook endpoint at /api/payment/webhook/razorpay —
# set when you add that URL in Razorpay Dashboard > Settings > Webhooks.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

#  ────googleOAuthConfig ────────────────────
GOOGLE_CLIENT_ID=CLIENT_ID
GOOGLE_CLIENT_SECRET=CLIENT_SECRET
# ── Notes ────────────────────────────────────────────────────────────
# - RDS must be PostgreSQL 16, in the same VPC (or peered) as the EC2 host,
#   region ap-south-1.
# - ElastiCache must have cluster mode DISABLED, region ap-south-1.
# - Neither RDS nor ElastiCache should have a public endpoint; reachability
#   is via security groups (see DEPLOY_AWS.md).
# - QDRANT_HOST / QDRANT_PORT are NOT set here — they stay hardcoded to
#   the qdrant container in docker-compose.aws.yml since Qdrant runs
#   on EC2, not as a managed AWS service.
