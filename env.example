# ============================================================================
# CheckMyBond - production environment file
# ----------------------------------------------------------------------------
# Save as  .env  in the SAME folder as docker-compose.yml, then:
#     chmod 600 .env
# Never commit .env to git (add it to .gitignore).
#
# Lines marked  [GENERATE]  must be replaced with a random value. Quick way:
#     openssl rand -hex 32
# Lines marked  [REQUIRES COMPOSE EDIT]  only take effect after you add the
# matching lines to docker-compose.yml (shown in the reply that came with
# this file) - Docker Compose does NOT pass a variable into a container
# unless the compose file lists it.
# ============================================================================


# ── 1. Core / security ──────────────────────────────────────────────────────

# [GENERATE] Signs login tokens. At least 32 random characters. Changing it
# logs every user out.
JWT_SECRET=

# Your public site address(es), exactly as typed in the browser, no trailing
# slash. Several allowed, comma-separated.
CORS_ORIGINS=https://yourdomain.com

# First admin account created for the platform. Change the password!
OWNER_USERNAME=owner
OWNER_PASSWORD=

# Show the API docs (Swagger) publicly? Keep false in production.
EXPOSE_DOCS=false


# ── 2. Database ─────────────────────────────────────────────────────────────

DB_DRIVER=postgres

# [GENERATE] [REQUIRES COMPOSE EDIT]  Use only letters and digits
# (openssl rand -hex 24) so it is safe inside a database URL.
POSTGRES_PASSWORD=


# ── 3. Extraction mode (OCR vs LLM) ─────────────────────────────────────────

# false = OCR region-drawing pipeline, no API key needed (default).
# true  = schema-based AI extraction; needs GROQ_API below.
USE_LLM=false
GROQ_API=
ANTHROPIC_API_KEY=


# ── 4. Payments ─────────────────────────────────────────────────────────────

# mock | stripe | razorpay
# mock = every payment "succeeds" instantly. NEVER use mock with real customers.
PAYMENT_GATEWAY=mock

# Stripe (only if PAYMENT_GATEWAY=stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay (only if PAYMENT_GATEWAY=razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# ── 5. "Continue with Google" login (optional, leave blank to disable) ──────

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ── 6. Email (password reset, login codes, contact form, alert emails) ──────
# [REQUIRES COMPOSE EDIT] on hitl-server.
# With EMAIL_PROVIDER=stdout (or missing keys) emails are only printed in the
# server log - nobody receives them.

# brevo | sendgrid | stdout
EMAIL_PROVIDER=brevo

BREVO_API_KEY=
BREVO_FROM_EMAIL=alerts@yourdomain.com     # must be a verified sender in Brevo

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Shown in alert-email subject lines
APP_NAME=CheckMyBond


# ── 7. Monitoring / logging ─────────────────────────────────────────────────
# [REQUIRES COMPOSE EDIT] on hitl-server and gateway (METRICS_PORT on
# celery-worker).

# Optional. /metrics is not published outside Docker, so leaving this empty is
# acceptable. If you set it, ALSO add  bearer_token: "<same value>"  to each
# scrape job in ops/prometheus/prometheus.yml or Prometheus will get 401s.
METRICS_TOKEN=

LOG_FORMAT=json              # json | text
SLOW_QUERY_MS=500            # log DB queries slower than this
ALERT_EVAL_INTERVAL_SECONDS=30
APP_VERSION=1.0.0

# Celery worker metrics port (must match the Prometheus target celery-worker:9200)
METRICS_PORT=9200

# Link included in alert emails (only if you run Grafana), e.g.
# GRAFANA_DASHBOARD_URL=http://localhost:3001/d/overview
GRAFANA_DASHBOARD_URL=

# Used by ops/docker-compose.observability.yml when started with
# --profile grafana
GRAFANA_ADMIN_PASSWORD=


# ── Not in this file ────────────────────────────────────────────────────────
# Backups have their own file: ops/backup/backup.env (DB access, 100 MB alert,
# 500/800/1000 MB limit, S3 switch, healthchecks.io URL).
# Alert RECIPIENTS are not an env variable: add them in the admin page
# (/admin/alerts) or nobody gets alert emails.
